// App CI: install, test, quality gate, image build for the backend + frontend.
pipeline {
    agent any

    environment {
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Install deps') {
            steps {
                dir('backend') {
                    sh 'pip install -q -r requirements.txt'
                }
            }
        }

        stage('Test') {
            steps {
                dir('backend') {
                    sh 'pytest tests/ --junitxml=test-results.xml'
                }
            }
            post {
                always {
                    junit 'backend/test-results.xml'
                }
            }
        }

        stage('SonarQube quality gate') {
            // Scoped to ingestion/shadow/control/usage_monitor on purpose:
            // the real risk in this codebase is concurrency bugs and
            // unhandled exceptions in long-running asyncio loops driving
            // real electrical appliances, not repo-wide style.
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh 'sonar-scanner -Dsonar.projectKey=home-automation-platform'
                }
            }
        }

        stage('Quality gate wait') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build images') {
            steps {
                sh 'docker build -t home-automation/api:${IMAGE_TAG} -f backend/Dockerfile.api backend'
                sh 'docker build -t home-automation/core-engine:${IMAGE_TAG} -f backend/Dockerfile.engine backend'
                sh 'docker build -t home-automation/frontend:${IMAGE_TAG} frontend'
            }
        }
    }
}
