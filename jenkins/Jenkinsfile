// App CI: lint + test + quality gate + image build for the backend services.
// This is generic build/test pipeline — the OTA-specific pipeline lives in
// Jenkinsfile.firmware, which is where Jenkins does something this project
// specifically needs.
pipeline {
    agent any

    environment {
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Install deps') {
            steps {
                dir('backend') {
                    sh 'pip install -q -r requirements.txt'
                }
            }
        }

        stage('Test') {
            steps {
                dir('backend') {
                    sh 'pytest tests/ --junitxml=test-results.xml'
                }
            }
            post {
                always {
                    junit 'backend/test-results.xml'
                }
            }
        }

        stage('SonarQube quality gate') {
            // Scoped to the ingestion/shadow/rollout modules on purpose: the
            // real risk in this codebase is concurrency bugs and unhandled
            // exceptions in long-running asyncio loops, not repo-wide style.
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh 'sonar-scanner -Dsonar.projectKey=iot-fleet-ota-platform'
                }
            }
        }

        stage('Quality gate wait') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build images') {
            steps {
                sh 'docker build -t iot-fleet/api:${IMAGE_TAG} -f backend/Dockerfile.api backend'
                sh 'docker build -t iot-fleet/core-engine:${IMAGE_TAG} -f backend/Dockerfile.engine backend'
                sh 'docker build -t iot-fleet/frontend:${IMAGE_TAG} frontend'
            }
        }
    }
}
